# Safe default: zero hosted-model calls and zero API quota usage.
NEUROGUARD_AI_MODE=local

# Only needed when deliberately enabling the hosted structured-output provider.
# NEUROGUARD_AI_MODE=openai
# OPENAI_API_KEY=replace_with_your_key
# OPENAI_MODEL=gpt-5.6-luna

# Hard limits remain enforced when hosted mode is enabled.
NEUROGUARD_MAX_LLM_RPM=10
NEUROGUARD_MAX_LLM_RPD=50

# Privacy-preserving defaults.
NEUROGUARD_STORE_RAW_INPUT=false
NEUROGUARD_RETENTION_DAYS=30
